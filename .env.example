# CarePrep (SIH26047) Environment Configuration

# MongoDB Database Configuration
MONGODB_USER=your_mongodb_user
MONGODB_PASSWORD=your_mongodb_password
MONGODB_DB_NAME=careprep
MONGODB_URI=mongodb+srv://your_mongodb_user:your_mongodb_password@cluster0.mongodb.net/careprep?retryWrites=true&w=majority

# Google Gemini AI Configuration
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server Port
PORT=3001

# Vite / SIH Demo Tools
VITE_ENABLE_SIH_DEMO_TOOLS=false

# Optional Developer / Test Mock Mode
# Set to 'true' to develop and test without consuming live Gemini API quota
# In production, this MUST remain 'false' or unset.
GEMINI_MOCK_MODE=false
